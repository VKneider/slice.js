{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slicejs.local/sliceConfig.schema.json",
  "title": "Slice.js Config",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "debugger": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "click": { "type": "string", "enum": ["right", "left"] },
        "leakInspector": {
          "type": "object",
          "additionalProperties": true,
          "description": "Dev-only memory-leak panel. Disabled in production regardless of this flag.",
          "properties": {
            "enabled": { "type": "boolean" },
            "shortcut": { "type": "string" }
          }
        }
      }
    },
    "stylesManager": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "requestedStyles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "themeManager": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "defaultTheme": { "type": "string" },
        "saveThemeLocally": { "type": "boolean" },
        "useBrowserTheme": { "type": "boolean" }
      }
    },
    "logger": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "showLogs": { "type": "object", "additionalProperties": true },
        "ui": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "shortcut": { "type": "string" }
          }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "ui": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "shortcut": { "type": "string" }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "ui": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "shortcut": { "type": "string" }
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "components": { "type": "object", "additionalProperties": true },
        "themes": { "type": "string" },
        "styles": { "type": "string" },
        "routesFile": { "type": "string" }
      },
      "required": ["components", "themes", "styles", "routesFile"]
    },
    "router": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "defaultRoute": { "type": "string" }
      }
    },
    "translator": {
      "type": "object",
      "additionalProperties": false,
      "description": "slice.translator: dictionaries in <path>/<locale>.json, data-t in templates, slice.t() and slice.translator.key() in code.",
      "properties": {
        "enabled": { "type": "boolean", "description": "Off: slice.t() returns the key and nothing is loaded." },
        "defaultLocale": { "type": "string", "minLength": 1 },
        "fallbackLocale": { "type": ["string", "null"], "description": "Asked when the active locale lacks a key." },
        "locales": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "path": { "type": "string", "description": "Where dictionaries are served from. Default /locales." },
        "saveLocally": { "type": "boolean", "description": "Remember the user's choice in localStorage." },
        "useBrowserLocale": { "type": "boolean", "description": "First visit: the browser's language when supported." },
        "routing": {
          "enum": [false, "prefix", "prefix-except-default"],
          "description": "Locale in the URL. false keeps it out; prefix puts it in every URL; prefix-except-default leaves the default locale unprefixed."
        },
        "ui": {
          "type": "object",
          "additionalProperties": true,
          "properties": { "enabled": { "type": "boolean" }, "shortcut": { "type": "string" } }
        }
      },
      "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
      "then": { "required": ["defaultLocale"] }
    },
    "loading": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "port": { "type": "number" },
        "host": { "type": "string" }
      }
    }
  }
}
